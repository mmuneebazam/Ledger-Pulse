<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===== Groups ===== -->
    <record id="module_category_ledger_pulse" model="ir.module.category">
        <field name="name">LedgerPulse</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_pulse_user" model="res.groups">
        <field name="name">Pulse User</field>
        <field name="category_id" ref="module_category_ledger_pulse"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_pulse_manager" model="res.groups">
        <field name="name">Pulse Manager</field>
        <field name="category_id" ref="module_category_ledger_pulse"/>
        <field name="implied_ids" eval="[(4, ref('group_pulse_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_pulse_integration_admin" model="res.groups">
        <field name="name">Pulse Integration Admin</field>
        <field name="category_id" ref="module_category_ledger_pulse"/>
        <field name="implied_ids" eval="[(4, ref('group_pulse_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- ===== Multi-company record rules (global) ===== -->
    <record id="rule_pulse_config_company" model="ir.rule">
        <field name="name">Pulse Config: multi-company</field>
        <field name="model_id" ref="model_pulse_config"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_pulse_api_key_company" model="ir.rule">
        <field name="name">Pulse API Key: multi-company</field>
        <field name="model_id" ref="model_pulse_api_key"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_pulse_request_log_company" model="ir.rule">
        <field name="name">Pulse Request Log: multi-company</field>
        <field name="model_id" ref="model_pulse_request_log"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_pulse_event_company" model="ir.rule">
        <field name="name">Pulse Event: multi-company</field>
        <field name="model_id" ref="model_pulse_event"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_pulse_job_company" model="ir.rule">
        <field name="name">Pulse Job: multi-company</field>
        <field name="model_id" ref="model_pulse_job"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_pulse_cash_bridge_company" model="ir.rule">
        <field name="name">Pulse Cash Bridge: multi-company</field>
        <field name="model_id" ref="model_pulse_cash_bridge"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_pulse_close_checklist_company" model="ir.rule">
        <field name="name">Pulse Close Checklist: multi-company</field>
        <field name="model_id" ref="model_pulse_close_checklist"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_pulse_score_rule_company" model="ir.rule">
        <field name="name">Pulse Score Rule: multi-company</field>
        <field name="model_id" ref="model_crm_lead_score_rule"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>