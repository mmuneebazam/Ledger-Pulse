    <record id="cron_pulse_bank_auto_match" model="ir.cron">
        <field name="name">LedgerPulse: auto-match bank statement lines</field>
        <field name="model_id" ref="model_pulse_bank_match"/>
        <field name="state">code</field>
        <field name="code">model._cron_auto_match()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
    <record id="cron_pulse_period_closed" model="ir.cron">
        <field name="name">LedgerPulse: emit period.closed events</field>
        <field name="model_id" ref="model_pulse_close_checklist"/>
        <field name="state">code</field>
        <field name="code">model._cron_emit_period_closed()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
